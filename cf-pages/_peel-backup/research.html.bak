<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Research · Class → Study — DualisCapax</title>
  <meta name="theme-color" content="#0B0E14">
  <meta name="description" content="Look free. Leaf $49 · Branch $299 · Trunk $499 · Atlas $1,499. Medical SEAL for Phase-3 / market-path orgs. Simulation is not treatment.">
  <link rel="manifest" href="manifest.json">
  <link rel="stylesheet" href="lander.css">
</head>
<body id="top">
  <header class="top-nav">
    <a href="index.html" class="brand-group">
      <svg class="brand-icon" viewBox="0 0 40 40" fill="none">
        <polygon points="20,4 35,14 35,30 20,38 5,30 5,14" stroke="#38BDF8" stroke-width="2.5" fill="none"/>
        <circle cx="20" cy="4" r="2.5" fill="#38BDF8"/>
      </svg>
      <span class="brand-name">Dualiscapax</span>
    </a>
    <a href="onboard.html" class="nav-btn-solid" style="text-decoration:none;">Start $0 Simulation</a>
  </header>
  <div style="padding:0.65rem 1.25rem; border-bottom:1px solid var(--border-subtle); display:flex; flex-wrap:wrap; gap:0.65rem; align-items:center; background:rgba(11,14,20,0.9);">
    <a class="subpage-back" href="index.html">← Lander</a>
      <a href="index.html#ask-iris" style="color:var(--text-secondary);text-decoration:none;font-size:0.72rem;font-family:var(--font-mono);">Ask Iris</a>
      <a href="research.html" style="color:var(--accent-pink);text-decoration:none;font-size:0.72rem;font-family:var(--font-mono);">Research</a>
      <a href="physics.html" style="color:var(--text-secondary);text-decoration:none;font-size:0.72rem;font-family:var(--font-mono);">Engineering</a>
      <a href="fuel.html" style="color:var(--text-secondary);text-decoration:none;font-size:0.72rem;font-family:var(--font-mono);">Fuel</a>
      <a href="runtime.html" style="color:var(--text-secondary);text-decoration:none;font-size:0.72rem;font-family:var(--font-mono);">Runtime</a>
      <a href="onboard.html" style="color:var(--text-secondary);text-decoration:none;font-size:0.72rem;font-family:var(--font-mono);">Onboard</a>
  </div>
  <main class="subpage-main page-wrapper">
    <section id="sector-research" class="pillar-section border-pink" data-medical-depth="0">
      <div class="badge-pill badge-pink">04 · Research // Computational Systems Biology</div>
      <h2 class="section-headline">Classification first. Then the study.</h2>
      <p class="section-body">
        Pick a disease class (neurology, oncology, …), then the specific model. <strong>Look is free.</strong>
        Depth maps to Leaf / Branch / Trunk / Atlas. Medical SEAL depth is for organizations that can run Phase 3 or otherwise bring an asset to market — not a consumer unlock.
        Simulation is not treatment.
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.5rem;margin:1rem 0 1.25rem;">
        <div style="background:var(--bg-surface);border:1px solid var(--accent-mint);border-radius:10px;padding:0.65rem;"><div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--accent-mint);">L0</div><div style="font-weight:800;font-size:0.9rem;">Look</div><div style="font-size:0.72rem;color:var(--text-muted);">CAD $0 · open</div></div>
        <div style="background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:10px;padding:0.65rem;"><div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--accent-cyan);">SKU-017</div><div style="font-weight:800;font-size:0.9rem;">Leaf</div><div style="font-size:0.72rem;color:var(--text-muted);">CAD $49 · one room</div></div>
        <div style="background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:10px;padding:0.65rem;"><div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--accent-cyan);">SKU-018</div><div style="font-weight:800;font-size:0.9rem;">Branch</div><div style="font-size:0.72rem;color:var(--text-muted);">CAD $299 · clade</div></div>
        <div style="background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:10px;padding:0.65rem;"><div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--accent-cyan);">SKU-019</div><div style="font-weight:800;font-size:0.9rem;">Trunk</div><div style="font-size:0.72rem;color:var(--text-muted);">CAD $499 · class list</div></div>
        <div style="background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:10px;padding:0.65rem;"><div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--accent-cyan);">SKU-029</div><div style="font-weight:800;font-size:0.9rem;">Atlas</div><div style="font-size:0.72rem;color:var(--text-muted);">CAD $1,499 · index</div></div>
        <div style="background:var(--bg-surface);border:1px dashed var(--border-subtle);border-radius:10px;padding:0.65rem;opacity:0.85;"><div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--text-muted);">SEAL-1</div><div style="font-weight:800;font-size:0.9rem;color:var(--text-secondary);">SEAL</div><div style="font-size:0.72rem;color:var(--text-muted);">Institutions only · not public</div></div>
      </div>

      <div class="filter-grid">
        <div>
          <label style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; display:block; margin-bottom:0.35rem;">
            1. Classification
          </label>
          <select class="styled-select" id="domainSelect" onchange="updateResearchDomain()" oninput="updateResearchDomain()">
            <option value="neuro">🧠 Human Neurology & Neuro-Immunology</option>
            <option value="onco">🔬 Human Oncology & Cellular Dynamics</option>
            <option value="critical">🏥 Critical Care & Metabolic</option>
            <option value="plantae">🌱 Kingdom Plantae</option>
            <option value="animal">🐾 Kingdom Animalia</option>
            <option value="master">📚 Atlas / cross-kingdom index</option>
            <option value="institutional">🏛️ Institutional SEAL · Phase-3 agencies only</option>
          </select>
        </div>
        <div>
          <label style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; display:block; margin-bottom:0.35rem;">
            2. Study / model
          </label>
          <select class="styled-select" id="studySelect" onchange="renderSpecificStudy()" oninput="renderSpecificStudy()"></select>
        </div>
      </div>

      <div id="studyCardBox" style="background:var(--bg-main); border:1px solid var(--border-subtle); border-radius:14px; padding:1.5rem; margin-top:0.75rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.5rem;">
          <span style="font-size:0.78rem; font-family:var(--font-mono); color:var(--accent-pink); font-weight:700;" id="studySku">—</span>
          <span style="font-size:0.72rem; font-family:var(--font-mono); color:var(--accent-cyan); background:rgba(56,189,248,0.1); padding:0.2rem 0.5rem; border-radius:4px;" id="studyWatchdog">Watchdog</span>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; background:rgba(255,255,255,0.03); border:1px solid var(--border-subtle); border-radius:6px; padding:0.35rem 0.65rem; margin-bottom:0.75rem; font-family:var(--font-mono); font-size:0.72rem;">
          <span style="color:var(--accent-pink);" id="medDomainCensus">Neurology & CNS</span>
          <span style="color:var(--text-muted);" id="medDomainShare">density</span>
        </div>
        <h3 style="font-size:1.25rem; font-weight:800; color:var(--text-primary); margin-bottom:0.5rem;" id="studyTitle">Loading study…</h3>
        <p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.55; margin-bottom:1rem;" id="studyDesc"></p>
        <div style="background:var(--bg-surface); padding:0.85rem; border-radius:8px; border:1px solid var(--border-subtle); margin-bottom:1rem; font-size:0.82rem; font-family:var(--font-mono); color:var(--text-secondary);" id="studyTargets"></div>
        <div style="font-size:1.25rem; font-weight:900; color:var(--accent-mint); margin-bottom:0.85rem;" id="studyPrice">CAD $49 · Leaf</div>
        <div id="studyGatePanel" style="border-top:1px solid var(--border-subtle); padding-top:1rem;"></div>
      </div>
    </section>

    <section id="med-gate" class="pillar-section border-purple" style="margin-top:1.25rem;border-color:var(--accent-purple);">
      <div class="badge-pill" style="border-color:var(--accent-purple);color:var(--accent-purple);">Medical gate · SEAL (not public checkout)</div>
      <h2 class="section-headline" style="font-size:1.25rem;">Institutional Phase-3 path</h2>
      <p class="section-body">
        SEAL is clickable for authorized agencies — but it is <strong>not a public Stripe product</strong>.
        In medicine, that premium only clears for organizations that can run Phase 3 / take an asset to market.
        General visitors stay on Look (free) and Leaf / Branch / Atlas pricing when the jacket opens.
      </p>
      <p id="sealDenyNote" style="display:none;font-size:0.85rem;color:var(--accent-pink);background:rgba(244,63,94,0.08);border:1px solid rgba(244,63,94,0.35);border-radius:8px;padding:0.75rem 0.9rem;margin:0.75rem 0;line-height:1.45;"></p>
      <ul style="font-size:0.88rem;color:var(--text-secondary);line-height:1.55;margin:0.75rem 0 1rem;padding-left:1.1rem;">
        <li>Door: institutional <code style="font-family:var(--font-mono);font-size:0.78rem;">.org</code> / <code style="font-family:var(--font-mono);font-size:0.78rem;">.gov</code> / <code style="font-family:var(--font-mono);font-size:0.78rem;">.gc.ca</code>, or Dualis-issued <code style="font-family:var(--font-mono);font-size:0.78rem;">SEAL-1</code></li>
        <li>Public: Look free · Leaf/Branch/Trunk/Atlas when jacket opens</li>
        <li>Unauthorized SEAL attempts: access denied — no consumer payment link</li>
        <li>Simulation is not treatment</li>
      </ul>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <button type="button" class="nav-btn-solid" style="font-size:0.8rem;padding:0.55rem 0.9rem;background:var(--accent-purple);" onclick="if(window.DC_MEDICAL&amp;&amp;DC_MEDICAL.prompt){DC_MEDICAL.prompt();}else if(typeof openPharmaInquiry==='function'){openPharmaInquiry();}else{var n=document.getElementById('sealDenyNote');if(n){n.style.display='block';n.textContent='Institutional verification required (.org / .gov / SEAL-1). Public checkout for SEAL is denied.';}}">Verify institutional access →</button>
        <a class="nav-btn-solid" href="physics.html#eng-gate" style="text-decoration:none;font-size:0.8rem;padding:0.55rem 0.9rem;background:transparent;border:1px solid var(--border-subtle);color:var(--text-secondary);">Engineering gate →</a>
      </div>
    </section>
  </main>
  <nav class="bottom-dock">
    <a href="index.html" class="dock-btn" style="text-decoration:none;"><span>Home</span></a>
    <a href="index.html#core-research" class="dock-btn" style="text-decoration:none;"><span>Research</span></a>
    <a href="physics.html" class="dock-btn" style="text-decoration:none;"><span>Engineering</span></a>
    <a href="onboard.html" class="dock-btn btn-trial" style="text-decoration:none;"><span>Pilot ($0)</span></a>
  </nav>
  <script src="js/payments-config.js"></script>
  <script src="js/buy-catalog.js"></script>
  <script src="js/access-layers.js"></script>
  <script src="js/medical-gate.js"></script>
  <script src="js/lander-peel-runtime.js"></script>
  <script>
    if (window.DCBuy) DCBuy.load('research/payment-links.json');
    (function dcForceStudyBind(){
      function wire(){
        var dom = document.getElementById('domainSelect');
        var study = document.getElementById('studySelect');
        if (!study || !window.renderSpecificStudy) return;
        function goStudy(){ try { window.renderSpecificStudy(); } catch(e){ console.warn(e); } }
        function goDom(){ try { window.updateResearchDomain(); } catch(e){ console.warn(e); } }
        study.addEventListener('change', goStudy);
        study.addEventListener('input', goStudy);
        if (dom) { dom.addEventListener('change', goDom); dom.addEventListener('input', goDom); }
        goDom();
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', wire);
      else setTimeout(wire, 0);
    })();
  </script>
</body>
</html>
