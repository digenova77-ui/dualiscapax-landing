        },
        {
          "key": "work_heat_power_flux",
          "status": "QUANTITY_FAMILIES"
        }
      ]
    },
    {
      "id": "AXIS-SCALE",
      "key": "spatial_temporal_and_system_scales",
      "items": [
        {
          "key": "quantum_and_particle",
          "status": "SCOPE_TAG"
        },
        {
          "key": "atomic_and_molecular",
          "status": "SCOPE_TAG"
        },
        {
          "key": "laboratory_and_material",
          "status": "SCOPE_TAG"
        },
        {
          "key": "biological_and_ecological",
          "status": "SCOPE_TAG"
        },
        {
          "key": "planetary_and_geophysical",
          "status": "SCOPE_TAG"
        },
        {
          "key": "stellar_and_galactic",
          "status": "SCOPE_TAG"
        },
        {
          "key": "cosmological",
          "status": "SCOPE_TAG"
        }
      ]
    },
    {
      "id": "AXIS-INFO",
      "key": "information_and_model_outputs",
      "items": [
        {
          "key": "human_report",
          "status": "SIGNAL_CLASS"
        },
        {
          "key": "instrument_telemetry",
          "status": "SIGNAL_CLASS"
        },
        {
          "key": "derived_measurement",
          "status": "SIGNAL_CLASS"
        },
        {
          "key": "simulation_output",
          "status": "SIGNAL_CLASS"
        },
        {
          "key": "theoretical_prediction",
          "status": "SIGNAL_CLASS"
        },
        {
          "key": "unresolved_or_unobserved",
          "status": "KNOWLEDGE_STATE"
        }
      ]
    }
  ],
  "evidence_states": [
    "OBSERVED",
    "INFERRED",
    "HYPOTHESIS",
    "INDEPENDENTLY_VALIDATED",
    "REJECTED",
    "UNRESOLVED"
  ],
  "required_observation_fields": [
    "record_id",
    "axis_id",
    "channel",
    "source",
    "observed_at",
    "value_or_payload",
    "units_or_encoding",
    "method",
    "calibration_or_method_version",
    "uncertainty",
    "detection_limits",
    "evidence_state"
  ],
  "invariants": {
    "spectra_are_typed_not_conflated": true,
    "energy_form_is_not_a_spectrum_by_default": true,
    "absence_of_detection_is_not_proof_of_absence": true,
    "model_output_is_not_observation": true,
    "repeated_runs_do_not_upgrade_evidence_by_themselves": true,
    "preserve_unknowns_and_negative_results": true,
    "preserve_original_records_and_revision_history": true,
    "independent_validation_required_for_validated_status": true,
    "no_claim_of_exhaustive_inventory": true,
    "no_live_actuation_or_sensor_access_from_registry": true,
    "energy_values_must_have_units_and_provenance": true
  }
}
