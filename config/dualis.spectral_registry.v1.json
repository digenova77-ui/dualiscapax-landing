{
  "protocol": "dualis.spectra.v1",
  "version": 1,
  "status": "PROPOSED",
  "purpose": "A typed, extensible inventory for separating observation channels, physical spectra, energy forms, scales, and knowledge status without claiming exhaustive coverage.",
  "diamond_cycle": {
    "ceiling_to_floor": [
      "declare_scope_and_invariants",
      "enumerate_domains_and_observables",
      "select measurable quantities",
      "define instruments_and_units",
      "record observations_with_provenance",
      "validate independently"
    ],
    "floor_to_ceiling": [
      "check raw record integrity",
      "check units_and_calibration",
      "quantify uncertainty_and_detection_limits",
      "compare independent observations",
      "test competing models",
      "revise higher_level claims without erasing prior evidence"
    ],
    "repeat_rule": "Each pass creates a versioned review record. Repetition alone does not increase confidence; only new evidence or stronger validation may change status."
  },
  "rings": [
    {
      "id": "A",
      "key": "philosophy",
      "question": "What is being claimed, what does it mean, and which assumptions are being made?",
      "review": [
        "definitions",
        "assumptions",
        "scope",
        "epistemic_limits",
        "ethical_implications"
      ]
    },
    {
      "id": "B",
      "key": "physics",
      "question": "What is measurable, by which instrument, in what units, and with what uncertainty?",
      "review": [
        "observable",
        "measurement_method",
        "units",
        "calibration",
        "uncertainty",
        "detection_limits",
        "reproducibility"
      ]
    },
    {
      "id": "C",
      "key": "law",
      "question": "Which constraints, invariants, equations, policies, or formal rules apply?",
      "review": [
        "physical_constraints",
        "mathematical_consistency",
        "protocol_invariants",
        "legal_or_policy_constraints_when_applicable"
      ]
    }
  ],
  "decomposition_axes": [
    {
      "id": "AXIS-EM",
      "key": "electromagnetic_frequency_spectrum",
      "items": [
        {
          "key": "radio",
          "status": "ESTABLISHED_CATEGORY",
          "note": "Boundaries depend on convention and application."
        },
        {
          "key": "microwave",
          "status": "ESTABLISHED_CATEGORY",
          "note": "Often treated as a radio-frequency sub-band."
        },
        {
          "key": "infrared",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "visible",
          "status": "ESTABLISHED_CATEGORY",
          "note": "Human-visible band; boundaries vary by observer and convention."
        },
        {
          "key": "ultraviolet",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "x_ray",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "gamma_ray",
          "status": "ESTABLISHED_CATEGORY",
          "note": "X-ray/gamma classification may depend on production mechanism, not energy alone."
        }
      ]
    },
    {
      "id": "AXIS-WAVE",
      "key": "non_electromagnetic_wave_observations",
      "items": [
        {
          "key": "acoustic_and_seismic",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "surface_and_internal_mechanical_waves",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "gravitational_waves",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "plasma_and_magnetohydrodynamic_waves",
          "status": "ESTABLISHED_CATEGORY"
        }
      ]
    },
    {
      "id": "AXIS-PARTICLE",
      "key": "particle_and_radiation_channels",
      "items": [
        {
          "key": "charged_particles",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "neutrons",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "neutrinos",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "cosmic_rays",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "particle_flux_and_spectra",
          "status": "MEASUREMENT_FAMILY"
        }
      ]
    },
    {
      "id": "AXIS-ENERGY",
      "key": "energy_forms_and_transfer",
      "items": [
        {
          "key": "kinetic",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "potential",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "thermal_internal",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "chemical",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "electrical",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "magnetic_field_energy",
          "status": "ESTABLISHED_CATEGORY"
        },
        {
          "key": "radiant",
          "status": "ESTABLISHED_CATEGORY"
